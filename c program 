
#include <stdio.h>

#define ZONES 5
#define DAYS 7

void inputData(float temp[ZONES][DAYS],
               float humidity[ZONES][DAYS],
               int aqi[ZONES][DAYS]);

void displayData(float temp[ZONES][DAYS],
                 float humidity[ZONES][DAYS],
                 int aqi[ZONES][DAYS]);

void calculateAverages(float temp[ZONES][DAYS],
                       float humidity[ZONES][DAYS],
                       int aqi[ZONES][DAYS],
                       float avgTemp[ZONES],
                       float avgHumidity[ZONES],
                       float avgAQI[ZONES]);

void detectRiskZones(float temp[ZONES][DAYS],
                     float humidity[ZONES][DAYS],
                     int aqi[ZONES][DAYS],
                     int riskDays[ZONES]);

void computeGreenIndex(float avgTemp[ZONES],
                       float avgHumidity[ZONES],
                       float avgAQI[ZONES],
                       float greenIndex[ZONES]);

void displayRanking(float greenIndex[ZONES]);

void displayRecommendations(float avgTemp[ZONES],
                            float avgHumidity[ZONES],
                            float avgAQI[ZONES],
                            int riskDays[ZONES]);

int main()
{
    float temp[ZONES][DAYS];
    float humidity[ZONES][DAYS];
    int aqi[ZONES][DAYS];

    float avgTemp[ZONES];
    float avgHumidity[ZONES];
    float avgAQI[ZONES];
    float greenIndex[ZONES];

    int riskDays[ZONES];
    int choice, dataReady = 0;
    int i;

    do
    {
        printf("\n===== ECOGUARD MENU =====\n");
        printf("1. Input / Update Data\n");
        printf("2. Display Data\n");
        printf("3. Zone-wise Averages\n");
        printf("4. Detect Risk Days\n");
        printf("5. Green Index and Ranking\n");
        printf("6. Recommendations\n");
        printf("7. Exit\n");

        printf("Enter your choice: ");
        scanf("%d", &choice);

        switch(choice)
        {
            case 1:
                inputData(temp, humidity, aqi);
                dataReady = 1;
                break;

            case 2:
                if(dataReady == 0)
                    printf("Please enter data first.\n");
                else
                    displayData(temp, humidity, aqi);
                break;

            case 3:
                if(dataReady == 0)
                    printf("Please enter data first.\n");
                else
                {
                    calculateAverages(temp, humidity, aqi,
                                      avgTemp, avgHumidity, avgAQI);

                    for(i = 0; i < ZONES; i++)
                    {
                        printf("\nZone %d\n", i + 1);
                        printf("Average Temperature: %.2f\n", avgTemp[i]);
                        printf("Average Humidity: %.2f\n", avgHumidity[i]);
                        printf("Average AQI: %.2f\n", avgAQI[i]);
                    }
                }
                break;

            case 4:
                if(dataReady == 0)
                    printf("Please enter data first.\n");
                else
                    detectRiskZones(temp, humidity, aqi, riskDays);
                break;

            case 5:
                if(dataReady == 0)
                    printf("Please enter data first.\n");
                else
                {
                    calculateAverages(temp, humidity, aqi,
                                      avgTemp, avgHumidity, avgAQI);

                    computeGreenIndex(avgTemp, avgHumidity,
                                       avgAQI, greenIndex);

                    displayRanking(greenIndex);
                }
                break;

            case 6:
                if(dataReady == 0)
                    printf("Please enter data first.\n");
                else
                {
                    calculateAverages(temp, humidity, aqi,
                                      avgTemp, avgHumidity, avgAQI);

                    detectRiskZones(temp, humidity, aqi, riskDays);

                    displayRecommendations(avgTemp, avgHumidity,
                                           avgAQI, riskDays);
                }
                break;

            case 7:
                printf("Exiting ECOGUARD. Thank you!\n");
                break;

            default:
                printf("Invalid choice. Try again.\n");
        }

    } while(choice != 7);

    return 0;
}

void inputData(float temp[ZONES][DAYS],
               float humidity[ZONES][DAYS],
               int aqi[ZONES][DAYS])
{
    int i, j;

    for(i = 0; i < ZONES; i++)
    {
        printf("\nEnter data for Zone %d\n", i + 1);

        for(j = 0; j < DAYS; j++)
        {
            do
            {
                printf("Day %d Temperature (10-50): ", j + 1);
                scanf("%f", &temp[i][j]);
            } while(temp[i][j] < 10 || temp[i][j] > 50);

            do
            {
                printf("Day %d Humidity (0-100): ", j + 1);
                scanf("%f", &humidity[i][j]);
            } while(humidity[i][j] < 0 || humidity[i][j] > 100);

            do
            {
                printf("Day %d AQI (0-500): ", j + 1);
                scanf("%d", &aqi[i][j]);
            } while(aqi[i][j] < 0 || aqi[i][j] > 500);
        }
    }
}

void displayData(float temp[ZONES][DAYS],
                 float humidity[ZONES][DAYS],
                 int aqi[ZONES][DAYS])
{
    int i, j;

    printf("\nTEMPERATURE MATRIX\n");

    for(i = 0; i < ZONES; i++)
    {
        for(j = 0; j < DAYS; j++)
            printf("%.1f ", temp[i][j]);

        printf("\n");
    }

    printf("\nHUMIDITY MATRIX\n");

    for(i = 0; i < ZONES; i++)
    {
        for(j = 0; j < DAYS; j++)
            printf("%.1f ", humidity[i][j]);

        printf("\n");
    }

    printf("\nAQI MATRIX\n");

    for(i = 0; i < ZONES; i++)
    {
        for(j = 0; j < DAYS; j++)
            printf("%d ", aqi[i][j]);

        printf("\n");
    }
}

void calculateAverages(float temp[ZONES][DAYS],
                       float humidity[ZONES][DAYS],
                       int aqi[ZONES][DAYS],
                       float avgTemp[ZONES],
                       float avgHumidity[ZONES],
                       float avgAQI[ZONES])
{
    int i, j;
    float t, h, a;

    for(i = 0; i < ZONES; i++)
    {
        t = 0;
        h = 0;
        a = 0;

        for(j = 0; j < DAYS; j++)
        {
            t += temp[i][j];
            h += humidity[i][j];
            a += aqi[i][j];
        }

        avgTemp[i] = t / DAYS;
        avgHumidity[i] = h / DAYS;
        avgAQI[i] = a / DAYS;
    }
}

void detectRiskZones(float temp[ZONES][DAYS],
                     float humidity[ZONES][DAYS],
                     int aqi[ZONES][DAYS],
                     int riskDays[ZONES])
{
    int i, j;

    for(i = 0; i < ZONES; i++)
    {
        riskDays[i] = 0;

        printf("\nZone %d Risk Days: ", i + 1);

        for(j = 0; j < DAYS; j++)
        {
            if(aqi[i][j] > 150 ||
               temp[i][j] > 35 ||
               humidity[i][j] > 80)
            {
                riskDays[i]++;
                printf("%d ", j + 1);
            }
        }

        printf("\nTotal Risk Days: %d\n", riskDays[i]);
    }
}

void computeGreenIndex(float avgTemp[ZONES],
                       float avgHumidity[ZONES],
                       float avgAQI[ZONES],
                       float greenIndex[ZONES])
{
    int i;
    float aqiScore, tempScore, humidityScore;
    float diff;

    for(i = 0; i < ZONES; i++)
    {
        aqiScore = 100 - (avgAQI[i] / 5);

        diff = avgTemp[i] - 25;
        if(diff < 0)
            diff = -diff;

        tempScore = 100 - (4 * diff);

        diff = avgHumidity[i] - 50;
        if(diff < 0)
            diff = -diff;

        humidityScore = 100 - (2 * diff);

        if(aqiScore < 0)
            aqiScore = 0;

        if(tempScore < 0)
            tempScore = 0;

        if(humidityScore < 0)
            humidityScore = 0;

        greenIndex[i] = (0.4 * aqiScore) +
                        (0.3 * tempScore) +
                        (0.3 * humidityScore);
    }
}

void displayRanking(float greenIndex[ZONES])
{
    int i, j, rank;

    printf("\n===== GREEN INDEX RANKING =====\n");

    for(i = 0; i < ZONES; i++)
    {
        rank = 1;

        for(j = 0; j < ZONES; j++)
        {
            if(greenIndex[j] > greenIndex[i])
                rank++;
        }

        printf("Zone %d: Green Index = %.2f, Rank = %d\n",
               i + 1, greenIndex[i], rank);
    }
}

void displayRecommendations(float avgTemp[ZONES],
                            float avgHumidity[ZONES],
                            float avgAQI[ZONES],
                            int riskDays[ZONES])
{
    int i;

    printf("\n===== ENVIRONMENTAL RECOMMENDATIONS =====\n");

    for(i = 0; i < ZONES; i++)
    {
        printf("\nZone %d:\n", i + 1);

        if(avgAQI[i] > 150)
            printf("Reduce vehicle idling or improve ventilation.\n");

        if(avgTemp[i] > 35)
            printf("Provide shade or increase green cover.\n");

        if(avgHumidity[i] > 80)
            printf("Check ventilation or stagnant water sources.\n");

        if(avgAQI[i] <= 150 &&
           avgTemp[i] <= 35 &&
           avgHumidity[i] <= 80)
        {
            if(riskDays[i] > 0)
                printf("Review the individual risk days.\n");
            else
                printf("Continue environmental monitoring.\n");
        }
    }
}
